# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
# Evaluation only. A successful build is not an approved release.
# The caller resolves the public base tag to a digest before building.
ARG BASE
FROM ${BASE}
USER 0:0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 RAG_PROFILE=production
WORKDIR /app
RUN ["python", "-c", "import os, pathlib, sys; assert sys.version_info[:2] == (3, 12); assert os.uname().machine == 'x86_64'; paths = [pathlib.Path('/var/lib/rag'), pathlib.Path('/run/rag-parser')]; [(p.mkdir(parents=True, exist_ok=True), p.chmod(0o700), os.chown(p, 10001, 10001)) for p in paths]"]
COPY requirements-runtime.lock .
RUN ["python", "-m", "pip", "install", "--no-cache-dir", "--only-binary=:all:", "--require-hashes", "-r", "requirements-runtime.lock"]
COPY app/ app/
COPY identity_policy.py disaster_recovery.py document_source.py reference_ranking.py reference_answer.py auth_oidc.py pdf_worker.py pdf_transport.py pdf_daemon.py production_admin.py production_store.py production_runtime.py query_intent.py rag_service.py ./
USER 10001:10001
EXPOSE 8000
ENTRYPOINT []
CMD ["python","-m","uvicorn","app.api:app","--host","0.0.0.0","--port","8000","--workers","1","--http","h11","--lifespan","on","--no-proxy-headers","--no-access-log","--limit-concurrency","32","--timeout-keep-alive","5","--timeout-graceful-shutdown","20"]
